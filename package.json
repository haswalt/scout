{
  "name": "scout",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/turbo/bin/turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "codegen": "turbo run codegen format",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --run",
    "test:coverage": "turbo run test -- --coverage --run",
    "generate:component": "turbo gen component"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.18",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2",
    "vercel": "^54.14.2"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=18"
  }
}
